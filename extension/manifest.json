{
  "manifest_version": 3,
  "name": "Tab Reaper",
  "version": "0.1.0",
  "description": "Automatically closes tabs you haven't used for a configurable amount of time.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Tab Reaper settings"
  }
}
